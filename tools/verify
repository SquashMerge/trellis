#!/bin/sh
# Factory runs verify as an argv-tokenized command, not through a shell.
# Independent lanes run concurrently. Each lane stops at its first failure;
# verify waits for every lane, prints each lane's output, and exits with the
# first failed lane's status.
set -eu

# Record the toolchain (pinned by rust-toolchain.toml) in every verify log.
rustc --version

# Bootstrap ignored Node packages and pinned Chromium before parallel lanes.
# Capture only the absolute browser path; setup diagnostics go to stderr.
PLAYWRIGHT_BROWSERS_PATH=$(node tools/verify-env.mjs)
export PLAYWRIGHT_BROWSERS_PATH

# Each Cargo target directory belongs to one lane, so no lane waits on
# another's build lock. The rust lane owns `target`: it lints the production
# build, lints again with the test-support hooks (off the tests lane's
# critical path), then builds the debug binary the browser suite runs. The
# tests lane owns `target-test-support` and runs the tests once, with the
# test-support hooks compiled in.
target_dir=${CARGO_TARGET_DIR:-target}
case $target_dir in
  /*) ;;
  *) target_dir=$PWD/$target_dir ;;
esac
rust() {
  cargo fmt --all -- --check
  cargo clippy --locked --all-targets -- -D warnings
  cargo clippy --locked --all-targets --features test-support -- -D warnings
  cargo build --locked --bin trellis
  TRELLIS_SUITE_BINARY="$target_dir/debug/trellis" node tests/browser/saved-items.test.cjs
}
tests() {
  if ! cargo nextest --version >/dev/null 2>&1; then
    echo "verify: cargo-nextest is required (brew install cargo-nextest, or cargo install cargo-nextest --locked)" >&2
    exit 127
  fi
  CARGO_TARGET_DIR="$target_dir-test-support" cargo nextest run --locked --all-targets --no-fail-fast --features test-support
}
semantic() {
  node tools/semantic-contract/test/run.mjs
}
cohorts() {
  node --test tools/synthetic-cohorts/test/cohorts.test.mjs
}
checks() {
  node --test runtime/acp/runner.test.mjs
  node --test tests/mcp-catalog-sdk.test.mjs
  python3 tools/stage3-watcher-runner-test.py
  node --test tests/factory-config.test.cjs
  node docs/semantic-evidence/check-policy.mjs
  node --check web/app.js
  node --test tests/question-ui.test.cjs tests/browse-ui.test.cjs tests/sequence-ui.test.cjs tests/token-ui.test.cjs tests/external-source-ui.test.cjs tests/dependency-ui.test.cjs tests/shell-ui.test.cjs tests/classes-ui.test.cjs tests/navigation-ui.test.cjs
}

lanes="rust tests semantic cohorts checks"
logs=$(mktemp -d "${TMPDIR:-/tmp}/trellis-verify.XXXXXX")
trap 'rm -rf "$logs"' EXIT
started=$(date +%s)
for lane in $lanes; do
  # The inner subshell keeps errexit (it is not the left side of || or &&);
  # the outer one records the lane's wall time whatever its outcome.
  (
    set +e
    start=$(date +%s)
    (set -e; "$lane")
    code=$?
    echo "<== verify lane $lane took $(($(date +%s) - start)) s"
    exit "$code"
  ) >"$logs/$lane" 2>&1 &
  eval "pid_$lane=$!"
done

status=0
failed=""
for lane in $lanes; do
  code=0
  eval "wait \$pid_$lane" || code=$?
  echo "==> verify lane $lane (exit $code)"
  cat "$logs/$lane"
  if [ "$code" -ne 0 ]; then
    [ "$status" -ne 0 ] || status=$code
    failed="$failed $lane"
  fi
done
echo "verify: lanes took $(($(date +%s) - started)) s"
if [ "$status" -ne 0 ]; then
  echo "verify: failed lane(s):$failed" >&2
fi
exit "$status"
