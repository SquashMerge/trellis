#!/bin/sh
# Factory runs verify as an argv-tokenized command, not through a shell.
# Independent lanes run concurrently. Each lane stops at its first failure;
# verify waits for every lane, prints each lane's output, and exits with the
# first failed lane's status.
#
# Usage: ./tools/verify [--lane NAME]...
# With no --lane, every lane runs: rust tests semantic cohorts checks. CI runs
# lanes as separate jobs by naming them. The rust lane is lint then browser;
# each half is also a lane of its own, so CI can run them on separate runners.
set -eu

all_lanes="rust tests semantic cohorts checks"
lanes=""
while [ "$#" -gt 0 ]; do
  case $1 in
    --lane)
      [ "$#" -ge 2 ] || { echo "verify: --lane needs a lane name" >&2; exit 2; }
      lane=$2
      shift 2
      ;;
    --lane=*)
      lane=${1#--lane=}
      shift
      ;;
    *)
      echo "verify: unknown argument: $1 (usage: ./tools/verify [--lane rust|lint|browser|tests|semantic|cohorts|checks]...)" >&2
      exit 2
      ;;
  esac
  case $lane in
    rust | lint | browser | tests | semantic | cohorts | checks) ;;
    *)
      echo "verify: unknown lane: $lane" >&2
      exit 2
      ;;
  esac
  case " $lanes " in
    *" $lane "*) continue ;;
  esac
  lanes="$lanes $lane"
done
lanes=${lanes# }
case " $lanes " in
  *" rust "*)
    case " $lanes " in
      *" lint "* | *" browser "*)
        echo "verify: the rust lane already runs lint and browser; name either rust or its halves" >&2
        exit 2
        ;;
    esac
    ;;
esac
[ -n "$lanes" ] || lanes=$all_lanes

# User daemon settings must not make tests load local models or change diagnostics.
# Tests that need these settings set them explicitly on their own child commands.
unset TRELLIS_SEARCH_MODEL TRELLIS_SEARCH_BACKEND TRELLIS_INDEX_DIAGNOSTICS

# Record the toolchain (pinned by rust-toolchain.toml) in every verify log.
rustc --version

# Bootstrap ignored Node packages and pinned Chromium before parallel lanes.
# Capture only the absolute browser path; setup diagnostics go to stderr.
PLAYWRIGHT_BROWSERS_PATH=$(node tools/verify-env.mjs)
export PLAYWRIGHT_BROWSERS_PATH

logs=$(mktemp -d "${TMPDIR:-/tmp}/trellis-verify.XXXXXX")
deps_pid=""
# Signal a process and then its descendants (sudo relays TERM to apt).
stop_tree() {
  for child in $(pgrep -P "$1" 2>/dev/null); do
    stop_tree "$child"
  done
  kill -TERM "$1" 2>/dev/null || true
}
# An early lane failure can leave the background install running; stop and
# reap it on every exit before its logs go away.
cleanup() {
  if [ -n "$deps_pid" ] && kill -0 "$deps_pid" 2>/dev/null; then
    stop_tree "$deps_pid"
    wait "$deps_pid" 2>/dev/null || true
  fi
  rm -rf "$logs"
}
trap cleanup EXIT

# Linux CI sets TRELLIS_BROWSER_SYSTEM_DEPS to install Chromium's system
# packages (apt) while the lanes build. Only the browser suite at the end of
# the rust lane needs them, and a slow apt mirror would otherwise hold up the
# whole run (#244). The lane polls for the status file because it is a
# subshell and cannot `wait` on its sibling. Only a run that includes the
# browser suite starts the install.
case " $lanes " in
  *" rust "* | *" browser "*) browser_lane=1 ;;
  *) browser_lane="" ;;
esac
if [ -n "${TRELLIS_BROWSER_SYSTEM_DEPS:-}" ] && [ -n "$browser_lane" ]; then
  (
    start=$(date +%s)
    code=0
    node tests/browser/node_modules/playwright/cli.js install-deps chromium >"$logs/browser-deps.log" 2>&1 || code=$?
    echo "$code $(($(date +%s) - start))" >"$logs/browser-deps.tmp"
    mv "$logs/browser-deps.tmp" "$logs/browser-deps.status"
  ) &
  deps_pid=$!
fi
browser_system_deps() {
  [ -n "${TRELLIS_BROWSER_SYSTEM_DEPS:-}" ] || return 0
  waited=0
  while [ ! -e "$logs/browser-deps.status" ]; do
    if [ "$waited" -ge 1800 ]; then
      echo "verify: Chromium system package install did not finish within 1800 s" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  read -r code took <"$logs/browser-deps.status"
  echo "verify: Chromium system package install finished in $took s (exit $code); the browser suite waited $waited s"
  if [ "$code" -ne 0 ]; then
    cat "$logs/browser-deps.log" >&2
    echo "verify: Chromium system package install failed (exit $code)" >&2
    return 1
  fi
}

# Each Cargo target directory belongs to one lane, so no lane waits on
# another's build lock. The rust lane owns `target`: its lint half lints the
# production build, then lints again with the test-support hooks (off the tests
# lane's critical path); its browser half builds the debug binary the browser
# suite runs. Naming both halves in one run shares `target`, so they take turns
# on its build lock; CI runs them as separate jobs instead. The tests lane owns `target-test-support` and runs the tests once, with the
# test-support hooks compiled in.
target_dir=${CARGO_TARGET_DIR:-target}
case $target_dir in
  /*) ;;
  *) target_dir=$PWD/$target_dir ;;
esac
lint() {
  cargo fmt --all -- --check
  cargo clippy --locked --all-targets -- -D warnings
  cargo clippy --locked --all-targets --features test-support -- -D warnings
}
browser() {
  cargo build --locked --features test-support --bin trellis
  cp "$target_dir/debug/trellis" "$target_dir/debug/trellis-navigation-fixture"
  cargo build --locked --bin trellis
  python3 tools/verify-40-query-performance.py --smoke --binary "$target_dir/debug/trellis"
  browser_system_deps
  TRELLIS_NAVIGATION_FIXTURE_BINARY="$target_dir/debug/trellis-navigation-fixture" TRELLIS_SUITE_BINARY="$target_dir/debug/trellis" node --test --test-concurrency=1 tests/browser/sequence-harness.test.cjs tests/browser/pele-block-labels.test.cjs tests/browser/sequence-pele.test.cjs tests/browser/sequence.test.cjs tests/browser/sequence-cost.test.cjs tests/browser/brand.test.cjs tests/browser/connect.test.cjs tests/browser/viewer-shell.test.cjs tests/browser/files.test.cjs tests/browser/architecture-pele.test.cjs tests/browser/architecture.test.cjs tests/browser/treemap.test.cjs tests/browser/classes-pele.test.cjs tests/browser/classes-app.test.cjs tests/browser/navigation-resolved.test.cjs
}
rust() {
  lint
  browser
}
tests() {
  if ! nextest_version=$(cargo nextest --version 2>/dev/null); then
    echo "verify: cargo-nextest is required (brew install cargo-nextest, or cargo install cargo-nextest --locked)" >&2
    exit 127
  fi
  # GHSA-vc25-qg58-w57c: cargo-nextest 0.9.125–0.9.149 can execute code when rerunning a recording.
  nextest_version=$(printf '%s\n' "$nextest_version" | awk 'NR == 1 { print $2 }')
  if [ "$(printf '%s\n%s\n' 0.9.150 "$nextest_version" | sort -V | head -n 1)" != 0.9.150 ]; then
    echo "verify: cargo-nextest $nextest_version is affected by GHSA-vc25-qg58-w57c; upgrade to 0.9.150 or newer" >&2
    exit 127
  fi
  CARGO_TARGET_DIR="$target_dir-test-support" cargo nextest run --locked --all-targets --no-fail-fast --features test-support
}
semantic() {
  node tools/semantic-contract/test/run.mjs
}
cohorts() {
  node --test tools/synthetic-cohorts/test/cohorts.test.mjs
}
checks() {
  node --test tests/mcp-catalog-sdk.test.mjs
  python3 tools/stage3-watcher-runner-test.py
  python3 tools/verify-67-mixed-performance-test.py
  python3 tools/verify-40-query-performance-test.py
  python3 tools/verify-61-combined-gate-test.py
  python3 -m unittest discover -s tools/semantic-contract/test -p 'test_*.py'
  python3 -m unittest discover -s tools/release -p 'test_*.py'
  node --test tests/factory-config.test.cjs
  node docs/semantic-evidence/check-policy.mjs --self-test
  node --check web/app.js
  node --test tests/browse-ui.test.cjs tests/sequence-ui.test.cjs tests/token-ui.test.cjs tests/external-source-ui.test.cjs tests/dependency-ui.test.cjs tests/shell-ui.test.cjs tests/classes-ui.test.cjs tests/navigation-ui.test.cjs tests/metric-heat.test.cjs tests/viewer-metrics-ui.test.cjs tests/files-ui.test.cjs tests/architecture-ui.test.cjs tests/architecture-pele-ui.test.cjs tests/treemap-ui.test.cjs tests/treemap-pele.test.cjs
}

started=$(date +%s)
for lane in $lanes; do
  # The inner subshell keeps errexit (it is not the left side of || or &&);
  # the outer one records the lane's wall time whatever its outcome.
  (
    set +e
    start=$(date +%s)
    (set -e; "$lane")
    code=$?
    echo "<== verify lane $lane took $(($(date +%s) - start)) s"
    exit "$code"
  ) >"$logs/$lane" 2>&1 &
  eval "pid_$lane=$!"
done

status=0
failed=""
for lane in $lanes; do
  code=0
  eval "wait \$pid_$lane" || code=$?
  echo "==> verify lane $lane (exit $code)"
  cat "$logs/$lane"
  if [ "$code" -ne 0 ]; then
    [ "$status" -ne 0 ] || status=$code
    failed="$failed $lane"
  fi
done
echo "verify: lanes took $(($(date +%s) - started)) s"
if [ "$status" -ne 0 ]; then
  echo "verify: failed lane(s):$failed" >&2
fi
exit "$status"
