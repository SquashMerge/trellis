# global-counter
global-counter src/http.rs * -- #700: counts only the browser status reads' own blocking threads, never other readers
global-counter src/references.rs * -- a test-support limit that tests set, not a count
global-counter src/semantic_batch/testing.rs * -- unique stage and join id allocators; never asserted on
global-counter src/store/native_first/witness.rs family_reserves_before_decoding_prefetched_children -- local to one single-threaded test; its decode fn pointer cannot capture a counter
global-counter tests/daemon/daemon_cli.rs detached_with_log -- unique log file id allocator; never asserted on

# short-wait: the duration is the input under test, not a bound on a wait
short-wait tests/daemon/daemon_cli.rs metrics_protocol_deadline_covers_whole_frame_not_each_read -- the test expects this protocol deadline to expire
short-wait src/daemon/client.rs settling_ends_by_the_calls_bound -- the bound is the call's settle deadline under test
short-wait src/http/serving_holder_tests.rs failed_startup_reconciliation_backs_off_without_failing_fifo_head -- an upper bound on the computed retry deadline; nothing waits
short-wait src/store/sqlite_contention_type_tests.rs * -- read-scope deadline values under test; nothing waits
short-wait tests/daemon/daemon_checkout.rs failed_startup_backs_off_and_empty_idle_checkout_can_release -- #720 follow-up: release must land inside the startup backoff window; prove it with a hook, not wall time

# blocking-accept: the accept cannot hang the test
blocking-accept tests/daemon/daemon_mcp.rs try_paused_at -- accepts on a detached thread; the test waits on it only via recv_timeout(HANG_BACKSTOP)
blocking-accept tests/mcp/mcp_protocol.rs bind -- accepts on a detached thread; release() waits on it only via recv_timeout(HANG_BACKSTOP)
blocking-accept tests/mcp/mcp_protocol.rs serve_pauses -- a detached hook server for the test's lifetime; never joined
blocking-accept tests/mcp/mcp_protocol.rs earlier_call_is_decided_while_a_later_final_check_stalls -- a detached hook server for the test's lifetime; never joined
